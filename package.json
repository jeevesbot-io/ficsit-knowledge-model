{
  "name": "ficsit-knowledge-model",
  "version": "0.1.0",
  "private": true,
  "description": "Open data model for Satisfactory: one LinkML schema generating JSON Schema, SQL tables and an RDF/SHACL knowledge graph.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/solstice035/ficsit-knowledge-model.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "gen": "sh scripts/gen.sh",
    "build": "tsx src/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsonld": "1.5.15",
    "@types/node": "22.20.5",
    "@zazuko/env": "3.0.1",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsonld": "9.0.0",
    "oxigraph": "0.5.11",
    "prettier": "3.9.10",
    "rdf-validate-shacl": "0.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
