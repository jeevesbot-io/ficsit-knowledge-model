{
    "$defs": {
        "Building": {
            "additionalProperties": false,
            "description": "A building in the knowledge model (`Build_*_C`).",
            "properties": {
                "id": {
                    "description": "The game's class name, e.g. `Desc_IronPlate_C`.",
                    "type": "string"
                }
            },
            "required": [
                "id"
            ],
            "title": "Building",
            "type": "object"
        },
        "Factory": {
            "additionalProperties": false,
            "description": "One build site. Items enter as inputs, are made by production lines and leave as outputs.",
            "properties": {
                "factoryId": {
                    "description": "Unique within the plan, e.g. `steel-mill`.",
                    "type": "string"
                },
                "inputs": {
                    "description": "Flows that enter the factory.",
                    "items": {
                        "$ref": "#/$defs/FactoryInput"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "lines": {
                    "description": "Production lines. Omit them for a plan that only states targets, for a tool to solve.",
                    "items": {
                        "$ref": "#/$defs/ProductionLine"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "location": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Location"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Where the factory is."
                },
                "name": {
                    "description": "Display name.",
                    "type": "string"
                },
                "outputs": {
                    "description": "Flows that leave the factory (its targets).",
                    "items": {
                        "$ref": "#/$defs/ItemRate"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "factoryId",
                "name"
            ],
            "title": "Factory",
            "type": "object"
        },
        "FactoryInput": {
            "additionalProperties": false,
            "description": "A flow into the factory: from another factory in the plan when `fromFactory` is set, otherwise from the world (extraction or a train).",
            "properties": {
                "fromFactory": {
                    "description": "The factory in this plan that supplies the input.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "item": {
                    "description": "Item ID (game class name), e.g. `Desc_IronPlate_C`.",
                    "type": "string"
                },
                "ratePerMin": {
                    "description": "Items per minute, or m\u00b3 per minute for fluids.",
                    "minimum": 0,
                    "type": "number"
                }
            },
            "required": [
                "item",
                "ratePerMin"
            ],
            "title": "FactoryInput",
            "type": "object"
        },
        "Item": {
            "additionalProperties": false,
            "description": "An item in the knowledge model (`Desc_*_C`).",
            "properties": {
                "id": {
                    "description": "The game's class name, e.g. `Desc_IronPlate_C`.",
                    "type": "string"
                }
            },
            "required": [
                "id"
            ],
            "title": "Item",
            "type": "object"
        },
        "ItemRate": {
            "additionalProperties": false,
            "description": "A flow of one item.",
            "properties": {
                "item": {
                    "description": "Item ID (game class name), e.g. `Desc_IronPlate_C`.",
                    "type": "string"
                },
                "ratePerMin": {
                    "description": "Items per minute, or m\u00b3 per minute for fluids.",
                    "minimum": 0,
                    "type": "number"
                }
            },
            "required": [
                "item",
                "ratePerMin"
            ],
            "title": "ItemRate",
            "type": "object"
        },
        "Location": {
            "additionalProperties": false,
            "description": "Approximate centre of the factory in world coordinates.",
            "properties": {
                "x": {
                    "description": "East (m).",
                    "type": "number"
                },
                "y": {
                    "description": "South (m); north is \u2212y.",
                    "type": "number"
                },
                "z": {
                    "description": "Height (m).",
                    "type": [
                        "number",
                        "null"
                    ]
                }
            },
            "required": [
                "x",
                "y"
            ],
            "title": "Location",
            "type": "object"
        },
        "Plan": {
            "additionalProperties": false,
            "description": "One factory plan, made of one or more factories.",
            "properties": {
                "description": {
                    "description": "Free-text notes.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "factories": {
                    "description": "Factories in the plan.",
                    "items": {
                        "$ref": "#/$defs/Factory"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "gameVersion": {
                    "description": "Game version or data bundle the plan was made against, e.g. `1.1`.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "description": "Display name.",
                    "type": "string"
                },
                "ofpVersion": {
                    "const": "0",
                    "description": "Open Factory Plan version. This schema is version 0.",
                    "type": "string"
                },
                "tool": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Tool"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The tool that wrote the plan."
                }
            },
            "required": [
                "ofpVersion",
                "name",
                "factories"
            ],
            "title": "Plan",
            "type": "object"
        },
        "ProductionLine": {
            "additionalProperties": false,
            "description": "Identical machines running one recipe. Output per minute is machines \u00d7 clock/100 \u00d7 60/duration \u00d7 amount \u00d7 (1 + somersloops/slots).",
            "properties": {
                "building": {
                    "description": "Building that runs the recipe; must be one of the recipe's `producedIn`.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "clockPercent": {
                    "description": "Clock speed of every machine in the line (default 100).",
                    "maximum": 250,
                    "minimum": 1,
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "machines": {
                    "description": "Number of machines. Fractional plans round up and lower the clock.",
                    "minimum": 1,
                    "type": "integer"
                },
                "recipe": {
                    "description": "Recipe ID (game class name), e.g. `Recipe_IronPlate_C`.",
                    "type": "string"
                },
                "somersloops": {
                    "description": "Somersloops in each machine (default 0).",
                    "minimum": 0,
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            },
            "required": [
                "recipe",
                "machines"
            ],
            "title": "ProductionLine",
            "type": "object"
        },
        "Recipe": {
            "additionalProperties": false,
            "description": "A recipe in the knowledge model (`Recipe_*_C`).",
            "properties": {
                "id": {
                    "description": "The game's class name, e.g. `Desc_IronPlate_C`.",
                    "type": "string"
                }
            },
            "required": [
                "id"
            ],
            "title": "Recipe",
            "type": "object"
        },
        "Tool": {
            "additionalProperties": false,
            "description": "The tool that wrote the plan.",
            "properties": {
                "name": {
                    "description": "Display name.",
                    "type": "string"
                },
                "toolVersion": {
                    "description": "Version of the tool that wrote the plan.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "url": {
                    "description": "Home page of the tool.",
                    "format": "uri",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "name"
            ],
            "title": "Tool",
            "type": "object"
        }
    },
    "$id": "https://solstice035.github.io/ficsit-knowledge-model/ofp",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": false,
    "description": "One factory plan, made of one or more factories.",
    "metamodel_version": "1.12.0",
    "properties": {
        "description": {
            "description": "Free-text notes.",
            "type": [
                "string",
                "null"
            ]
        },
        "factories": {
            "description": "Factories in the plan.",
            "items": {
                "$ref": "#/$defs/Factory"
            },
            "minItems": 1,
            "type": "array"
        },
        "gameVersion": {
            "description": "Game version or data bundle the plan was made against, e.g. `1.1`.",
            "type": [
                "string",
                "null"
            ]
        },
        "name": {
            "description": "Display name.",
            "type": "string"
        },
        "ofpVersion": {
            "const": "0",
            "description": "Open Factory Plan version. This schema is version 0.",
            "type": "string"
        },
        "tool": {
            "anyOf": [
                {
                    "$ref": "#/$defs/Tool"
                },
                {
                    "type": "null"
                }
            ],
            "description": "The tool that wrote the plan."
        }
    },
    "required": [
        "ofpVersion",
        "name",
        "factories"
    ],
    "title": "ofp",
    "type": "object",
    "version": "0.1.0"
}

